{
	"compilerOptions": {
		/* Lenguaje y Entorno */
		"target": "ES2020",
		"lib": [
			"DOM",
			"ES2020"
		],
		"rootDir": "src",
		/* Módulos */
		"module": "esnext",
		"moduleResolution": "bundler",
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"isolatedModules": true,
		/* Emisión de archivos */
		"noEmit": true,
		/* Verificación de tipos estricta */
		"strict": true,
		"noImplicitAny": true,
		"strictNullChecks": true,
		/* Optimización */
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true
	},
	"include": [
		"src/**/*"
	],
	"exclude": [
		"node_modules",
		"dist"
	]
}